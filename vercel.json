{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "lanazgonjanin.vercel.app"
        }
      ],
      "destination": "https://www.cs.toronto.edu/~lana/:path*",
      "permanent": false
    }
  ]
}
